{
  "manifest_version": 3,
  "name": "DeepCite - Deep Research Citations",
  "version": "1.0.1",
  "description": "Export ChatGPT Deep Research reports to Markdown with citation sources preserved as footnotes.",
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://*.oaiusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeepCite — Merge citations into Markdown",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.oaiusercontent.com/*"],
      "all_frames": true,
      "match_about_blank": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
